// use prisma-next

model User {
  id        Int       @id @default(autoincrement())
  phone     String?   @unique
  email     String?   @unique
  name      String?
  role String @default("COSTUMER")

  addresses Address[]
  orders Order[]
  favorites Favorite[]

  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()
}

model Address {
  id          Int      @id @default(autoincrement())
  label       String?
  fullName    String
  phone       String
  governorate String
  city        String
  address     String
  notes       String?

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()
}

model Product {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  name          String
  description   String?
  price         Int
  active        Boolean          @default(true)
  category      String           @default("TSHIRT")
  audience      String           @default("UNISEX")

  deliveryPrice Int?

  orderItems    OrderItem[]
  favorites     Favorite[]
  images        ProductImage[]
  variants      ProductVariant[]

  createdAt     DateTime         @default(now())
  updatedAt     temporal.updatedAt()
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  position  Int     @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  sku       String  @unique
  size      String?
  color     String?
  price     Int?
  stock     Int     @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  orderItems OrderItem[]
}

model Order {
  id          Int      @id @default(autoincrement())

  status      String   @default("PENDING")

  subtotal    Int
  delivery    Int      @default(0)
  total       Int

  fullName    String
  phone       String
  governorate String
  city        String
  address     String
  notes       String?

  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])

  items       OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()
}

model OrderItem {
  id        Int            @id @default(autoincrement())

  quantity  Int
  price     Int

  orderId   Int
  order     Order          @relation(fields: [orderId], references: [id])

  productId Int
  product   Product        @relation(fields: [productId], references: [id])

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model OtpCode {
  id        Int      @id @default(autoincrement())

  phone     String   @unique
  codeHash  String
  attempts  Int      @default(0)
  used      Boolean  @default(false)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Favorite {
  userId    Int
  productId Int

  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@id([userId, productId])
}